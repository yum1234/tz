diff --git a/Makefile b/Makefile
index e51ffe0f..06b758ef 100644
--- a/Makefile
+++ b/Makefile
@@ -323,6 +323,8 @@ LDLIBS=
 #	    It also costs CPU time and memory.
 #  -Dtime_tz=\"T\" to use T as the time_t type, rather than the system time_t
 #	This is intended for internal use only; it mangles external names.
+#  -DMIN_TRANSITION_GAP=N to reject TZif files containing transitions
+#	separated by fewer than N seconds.  See localtime.c.
 #  -DTZ_CHANGE_INTERVAL=N if functions depending on TZ should check
 #	no more often than every N seconds for TZif file changes.
 #	If N is negative (the default), no such checking is done.
diff --git a/NEWS b/NEWS
index 45a8856d..0b0b1ead 100644
--- a/NEWS
+++ b/NEWS
@@ -15,6 +15,11 @@ Unreleased, experimental changes
     localtime.c no longer supports 49 leap seconds, as 27 now suffice.
     zic now warns if you go over the new limit.
 
+    A new compile-time flag -DMIN_TRANSITION_GAP=N specifies a minimum
+    transition gap of N seconds when reading TZif files.  It currently
+    defaults to 0, but can be set to 1 if TZif files generated by zic
+    2021b and earlier are no longer of concern.
+
     With 32-bit time_t, localtime.c functions now check for transition
     ordering in TZif data as carefully as they do with 64-bit time_t.
     (Problem reported by Ana Bobillo.)
diff --git a/localtime.c b/localtime.c
index 61013447..710889fe 100644
--- a/localtime.c
+++ b/localtime.c
@@ -443,6 +443,16 @@ static char const *utc = etc_utc + sizeof "Etc/" - 1;
 # define SUPPRESS_TZDIR 0
 #endif
 
+/* Minimum separation in seconds between adjacent transition times,
+   as a nonnegative signed integer.  RFC 9636 says it must be at most 1.
+   Currently it defaults to 0, to accept nonconforming
+   TZif files containing multiple transitions at the same time,
+   such as TZif files generated by bugs in zic 2021b and earlier.
+   It can default to 1 once the old zic versions are no longer of concern.   */
+#ifndef MIN_TRANSITION_GAP
+# define MIN_TRANSITION_GAP 0
+#endif
+
 /* Limit to time zone abbreviation length in proleptic TZ strings.
    This is distinct from TZ_MAX_CHARS, which limits TZif file contents.
    It defaults to 254, not 255, so that desigidx_type can be an unsigned char.
@@ -1123,13 +1133,28 @@ tzloadbody(char const *name, struct state *sp, char tzloadflags,
 			  = stored == 4 ? detzcode(p) : detzcode64(p);
 			if (at < atmin)
 			  return EFTYPE;
-			atmin = at;
+			else {
+#ifdef ckd_add
+			  bool v = ckd_add(&atmin, at, MIN_TRANSITION_GAP);
+#else
+			  bool v = INT_FAST64_MAX - MIN_TRANSITION_GAP < at;
+			  if (!v)
+			    atmin = at + MIN_TRANSITION_GAP;
+#endif
+			  /* If the next minimum value for 'at' overflows,
+			     any new 'at' value is less than what it
+			     should be, so fail if such a value exists.  */
+			  if (v && i + 1 < sp->timecnt)
+			    return EFTYPE;
+			}
+
 			sp->types[i] = at <= TIME_T_MAX;
 			if (sp->types[i]) {
 			  time_t attime
 			    = ((TYPE_SIGNED(time_t) ? at < TIME_T_MIN : at < 0)
 			       ? TIME_T_MIN : at);
-			  if (timecnt && sp->ats[timecnt - 1] == attime) {
+			  if (!MIN_TRANSITION_GAP && timecnt
+			      && sp->ats[timecnt - 1] == attime) {
 			    sp->types[i - 1] = 0;
 			    timecnt--;
 			  }
